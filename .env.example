# StagHerd environment template.
# Do not commit real credentials. Copy only the values needed by enabled providers
# in the host application's .env file.

# Webhook idempotency. Any driver other than "redis" uses the database store.
STAG_HERD_WEBHOOK_IDEMPOTENCY_DRIVER=database
STAG_HERD_WEBHOOK_IDEMPOTENCY_TTL=86400

# Stripe
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_BASE_URI=https://api.stripe.com

# PayPal
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Compatibility fallback when PAYPAL_CLIENT_SECRET is not set.
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URI=https://api-m.sandbox.paypal.com

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URI=https://api.mercadopago.com
