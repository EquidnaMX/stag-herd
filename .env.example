# StagHerd package environment template.
# Do not commit real credentials. Copy the relevant values into the host app .env.

STAG_HERD_ROUTE_PREFIX=stag-herd
STAG_HERD_PAYMENT_MODEL=App\Models\Payment

# Audit and webhook safety
STAG_HERD_AUDIT_CHANNEL=stack
STAG_HERD_AUDIT_ENABLED=true
WEBHOOK_IDEMPOTENCY_TTL=604800
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_DECAY=1

# Cleanup
STAG_HERD_CLEANUP_ENABLED=true
STAG_HERD_CLEANUP_CRON="0 3 * * *"
STAG_HERD_PAYMENT_TIMESTAMP_COLUMN=dt_registration
STAG_HERD_STALE_PENDING_DAYS=14
STAG_HERD_STALE_PENDING_STATUS=CANCELED
STAG_HERD_REVALIDATE_ENABLED=false
STAG_HERD_REVALIDATE_LOOKBACK_HOURS=24

# Enable only providers configured in the current environment.
STRIPE_ENABLED=false
PAYPAL_ENABLED=false
MERCADOPAGO_ENABLED=false
CONEKTA_ENABLED=false
OPENPAY_ENABLED=false
CLIP_ENABLED=false

# Stripe / Google Pay
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# PayPal
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TOKEN_TTL=3000
PAYPAL_RETURN_ROUTE=https://example.test/stag-herd/paypal/return
PAYPAL_CANCEL_ROUTE=https://example.test/stag-herd/paypal/cancel

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_RETURN_ROUTE=stag-herd.mercadopago.confirm

# Conekta
CONEKTA_API_SECRET=
# Use the webhook public key generated by Conekta. Escaped newlines are supported.
CONEKTA_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Openpay
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_SANDBOX=true
OPENPAY_WEBHOOK_SECRET=

# Clip Checkout
CLIP_API_KEY=
CLIP_API_BASE_URL=https://api-gw.payclip.com
CLIP_CURRENCY=MXN
CLIP_SUCCESS_URL=https://example.test/payments/success
CLIP_ERROR_URL=https://example.test/payments/error
CLIP_DEFAULT_URL=https://example.test/payments/cancel
CLIP_WEBHOOK_URL=https://example.test/stag-herd/clip
