{
  "name": "equidna/stag-herd",
  "description": "Multi-provider payment webhook verification and processing for Laravel.",
  "license": "MIT",
  "authors": [
    {
      "name": "Equidna Development Team",
      "email": "dev@equidna.org"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.21|^12.0|^13.0",
    "equidna/laravel-toolkit": "^1.0",
    "stripe/stripe-php": "^20.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.5.35|^11.5.3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Equidna\\StagHerd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Equidna\\StagHerd\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Equidna\\StagHerd\\StagHerdServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "phpstan": "vendor/bin/phpstan analyse"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
